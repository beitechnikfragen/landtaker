# Copy to .env and adjust. .env is gitignored.

NODE_ENV=development

# 8787 matches what the game derives for a `localhost` audience
# (ServerEnv.jwtIssuer). Changing it means changing the game too.
PORT=8787
HOST=0.0.0.0

# Host ports 5433/6380 — see docker-compose.yml. A locally installed
# Postgres/Redis usually owns 5432/6379 already.
DATABASE_URL=postgres://openfront:openfront@localhost:5433/openfront
REDIS_URL=redis://localhost:6380

JWT_ISSUER=http://localhost:8787
JWT_AUDIENCE=localhost
ACCESS_TOKEN_TTL_SECONDS=3600

# Ed25519 private key as a single-line JWK. Generate: npm run keys:generate
# Leave unset in development to get an ephemeral key (tokens die on restart).
# JWT_PRIVATE_KEY='{"kty":"OKP",...}'

# Must match the game server's API_KEY. The value below is the game's dev
# default, so `npm run dev` works untouched. Replace it in production.
API_KEY=WARNING_DEV_API_KEY_DO_NOT_USE_IN_PRODUCTION

# Cloudflare Turnstile, private half of the pair. The PUBLIC site key lives in
# the game server's env as TURNSTILE_SITE_KEY — this one belongs here and must
# never reach a client.
#
# Optional, and everything still works without it: guests can submit feedback
# and join verification behaves exactly as it did before Turnstile existed.
# What you lose is the check itself — with no secret there is nothing to
# verify a token against, so /feedback accepts guests unverified. Set it once
# you have registered a real Turnstile site; until then the dev site key
# (1x00000000000000000000AA) always passes anyway.
# TURNSTILE_SECRET_KEY=

# Comma-separated. 9000 is the Vite dev client.
CORS_ORIGIN=http://localhost:9000

# Where a login may return the browser to, compared by origin. Guards against
# an open redirect handing the fresh session to another site.
ALLOWED_REDIRECT_ORIGINS=http://localhost:9000

# Discord OAuth (https://discord.com/developers/applications -> OAuth2).
# Without both values the /auth/login/discord routes are not registered.
# DISCORD_REDIRECT_URI must be entered in the portal under "Redirects"
# character for character, including the scheme.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/auth/callback/discord

# Magic-link email via Resend (https://resend.com/api-keys). Without the key
# the /auth/magic-link and /auth/login/token routes are not registered.
# EMAIL_FROM must sit on a domain verified in Resend WITH SPF and DKIM DNS
# records — otherwise the mail is rejected or lands in spam, and a magic link
# in a spam folder is a broken login.
# RESEND_API_KEY=
EMAIL_FROM=Landtaker <noreply@landtaker.io>
EMAIL_PRODUCT_NAME=Landtaker
MAGIC_LINK_TTL_MINUTES=15
